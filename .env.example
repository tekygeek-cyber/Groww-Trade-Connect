# Optional: used for Google Gemini market-news briefings only.
# Ollama-powered AI research does not require an API key.
# Keep the actual key in your ignored .env file or your hosting provider's secret store.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AI Agent Mode (no paid API key required; runs on the APP SERVER)
# Install: https://ollama.com ; then: ollama pull qwen3:4b
# Use AI_ENABLED=false to disable local inference. No live order tools exist.
AI_ENABLED=true
AI_MODEL=qwen3:4b
AI_OLLAMA_URL=http://127.0.0.1:11434

# Authentication behind a reverse proxy / hosted preview
# Set this to the EXACT public browser URL (scheme + host + optional port).
# Example: APP_PUBLIC_ORIGIN=https://your-trading-desk.example.com
# Required when the proxy forwards an internal Host but the browser Origin
# contains the public HTTPS domain. No trailing slash, path, wildcards, or secrets.
# If omitted, a valid APP_URL is used; otherwise Host must match Origin.
# APP_PUBLIC_ORIGIN=https://your-trading-desk.example.com


# NEW owner-only Netlify Identity application layer (Step 2 lab)
# Stable, server-verified Netlify Identity USER ID, never an email address.
# NOT the Netlify project account ID used by Step 1's OWNER_NETLIFY_USER_ID.
# Set only in the private Netlify backend environment. No VITE_ prefix.
# OWNER_IDENTITY_SUB=
# OWNER_IDENTITY_USER_ID=  # legacy alias only; never set conflicting values
