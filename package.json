{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.js",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --test tests/auth-policy.test.mjs tests/security-policy.test.mjs tests/session-policy.test.mjs tests/ai-run-metrics.test.mjs",
    "test:auth-integration": "tsx --test tests/groww-auth.test.ts",
    "test:rebalance": "tsx --test tests/rebalance-guards.test.ts",
    "test:market-integrity": "tsx --test tests/market-integrity.test.ts tests/market-data-integrity.test.ts",
    "test:ai-harness": "node --test tests/ai-harness.test.mjs tests/ai-run-metrics.test.mjs",
    "test:risk-gate": "tsx --test tests/risk-gate.test.ts",
    "test:mock-broker": "tsx --test tests/mock-broker.test.ts",
    "test:kraken-readonly": "node --test tests/kraken-spot-readonly.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
